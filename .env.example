# Required: Your Anthropic API key for Claude Code
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Optional: Override the target repository (defaults to Graph contracts)
# AUDIT_TARGET=https://github.com/graphprotocol/contracts.git

# Optional: Branch to audit (defaults to main)
# AUDIT_BRANCH=main

# Optional: Packages to focus on (space-separated)
# AUDIT_SCOPE=packages/horizon packages/subgraph-service
